    "bench": "cargo run --release -p asp-desktop-engine --example bench_ops --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "asp-wasm": "file:../crates/asp-wasm/pkg-web",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/selenium-webdriver": "^4.35.6",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2",
    "jsdom": "^25",
    "selenium-webdriver": "^4.45.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2"
  }
}

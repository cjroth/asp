{
  "name": "context-desktop",
  "version": "0.1.26",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build:web": "tsc && vite build",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",

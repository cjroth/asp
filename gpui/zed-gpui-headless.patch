+    /// Like [`render_to_image`], but always available (not gated on
+    /// `test-support`). Renders the most recently drawn frame's scene to an
+    /// offscreen image and returns the pixels, without presenting to screen.
+    /// Used by headless screenshot/automation harnesses.
+    pub fn capture_image(&self) -> anyhow::Result<image::RgbaImage> {
+        self.platform_window
+            .render_to_image(&self.rendered_frame.scene)
+    }
